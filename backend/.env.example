NODE_ENV=development
PORT=4000
ALLOWED_ORIGINS=http://localhost:5173

# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/order_fast_db?retryWrites=true&w=majority
MONGODB_URI=

# URL pública del frontend, usada para armar el link que codifica el QR de cada mesa
FRONTEND_URL=http://localhost:5173

# Project Settings > API Keys
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Minutos promedio de preparación por pedido, usado para /orders/wait-estimate
AVERAGE_PREP_MINUTES=5
